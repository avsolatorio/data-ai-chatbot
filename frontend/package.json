      "@data360/mcp-viz-core": "0.0.2",
      "@data360/tool-types": "0.0.4"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@pcn-js/core": "*",
        "@pcn-js/ui": "*",
        "@pcn-js/data360": "*",
        "next": "*",
        "react": "*",
        "react-dom": "*",
        "@opentelemetry/api-logs": "*"
      }
    },
    "patchedDependencies": {
      "@data360/chart-payload-normalize@0.0.1": "patches/@data360__chart-payload-normalize@0.0.1.patch"
