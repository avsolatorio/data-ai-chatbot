{
  "name": "ai-chatbot",
  "version": "3.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "copymainfile": "node copymain.js",
    "postbuild": "node scripts/postbuild.js",
    "clean": "pnpm exec rimraf ./dist/ ./next/ ./.next/",
    "build:pcn": "pnpm --dir ../../pcn/packages/core build && pnpm --dir ../../pcn/packages/ui build && pnpm --dir ../../pcn/packages/data360 build",
    "copy:pcn": "node scripts/copy-pcn.js",
    "unlink:pcn": "pnpm install",
    "update:pcn": "pnpm update @pcn-js/core @pcn-js/ui @pcn-js/data360",
    "ensure-pcn": "node scripts/ensure-pcn-deps.js",
    "verify-pcn": "node scripts/verify-pcn.js",
    "dev": "next dev --turbo",
    "dev:local-pcn": "node scripts/dev-local-pcn.js",
    "prebuild": "node scripts/ensure-streamdown-for-tailwind.js",
    "build": "next build",
    "build:local": "node scripts/run-build.js local",
    "build:dev": "node scripts/run-build.js dev",
    "build:qa": "node scripts/run-build.js qa",
    "build:uat": "node scripts/run-build.js uat",
    "build:prod": "node scripts/run-build.js prod",
    "start": "next start",
    "start:dev": "cross-env PHASE=dev NEXT_PUBLIC_APP_ENV=dev next dev -p 4200",
    "lint": "npx ultracite check",
    "format": "npx ultracite fix",
    "env:check": "tsx scripts/env-check.ts",
    "test": "export PLAYWRIGHT=True && pnpm exec playwright test",
    "test:unit": "tsx --test lib/__tests__/**/*.test.ts"
  },
