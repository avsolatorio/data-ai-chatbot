# Frontend Dockerfile for local development
# NOT intended for production use

FROM node:20-alpine

WORKDIR /app

# Make sure the app directory is owned by the node user
RUN mkdir -p /app && chown -R node:node /app

# Install pnpm globally (needs root)
RUN --mount=type=secret,id=npmrc,target=/tmp/.npmrc,uid=1000,gid=1000,mode=0444,readonly \
    export NPM_CONFIG_USERCONFIG=/tmp/.npmrc && \
    npm install -g pnpm@10.26.0

# Run everything else as non-root
USER node

# Copy lockfiles first for caching
COPY --chown=node:node package.json pnpm-lock.yaml ./

# Copy patches before install — pnpm applies them during frozen lockfile install
COPY --chown=node:node patches/ ./patches/

# Install deps as node (avoids root-owned node_modules)
RUN --mount=type=secret,id=npmrc,target=/tmp/.npmrc,uid=1000,gid=1000,mode=0444,readonly \
    export NPM_CONFIG_USERCONFIG=/tmp/.npmrc && \
    pnpm install --frozen-lockfile

# Copy the rest of the code
COPY --chown=node:node . .

ENV NEXT_TELEMETRY_DISABLED=1

# Set environment variables for development
ENV NODE_ENV=production

# Build once (used by prod-like mode)
RUN pnpm build

EXPOSE 3001

# Default command (compose can override)
CMD ["pnpm", "start", "--port", "3001"]
