# =============================================================================
# Frontend environment variables
# =============================================================================
# Copy this file to .env.local (or .env) and set values for your environment.
# NEXT_PUBLIC_* variables are exposed to the browser; do not put secrets in them.
# =============================================================================

# -----------------------------------------------------------------------------
# URLs & base path (required for correct redirects, cookies, and API calls)
# -----------------------------------------------------------------------------

# Public URL of this app (no trailing slash). Used for redirects after guest
# login, metadata baseUrl, and validating redirect targets. Must match how users
# reach the app (scheme + host + optional port). Examples:
#   https://data360chat.worldbank.org
#   https://host.example.com/data360-chat  (if behind a path proxy)
#   http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Base path when the app is served under a subpath (no trailing slash).
# Leave empty if the app is at the site root. Must match Next.js basePath.
# Example: /data360-chat
NEXT_PUBLIC_BASE_PATH=

# Base URL used by the app when building server-side URLs (e.g. auth/me).
# Optional. If unset, falls back to http://127.0.0.1:${PORT} so the app talks
# to itself on the same port. Set when the app is behind a different public
# host (e.g. in Docker: http://frontend:3000).
NEXT_PUBLIC_BASE_URL=

# Backend API URL used by the browser for chat, history, etc. (no trailing slash).
# Example: https://api.example.com or http://localhost:8001
NEXT_PUBLIC_API_URL=

# Backend API URL used only on the server (guest route, /api/auth/me). Prefer
# this in Docker so the server talks to the backend via internal hostname.
# Fallback: NEXT_PUBLIC_API_URL, then http://localhost:8001
SERVER_API_URL=

# -----------------------------------------------------------------------------
# Server-only (never exposed to the client)
# -----------------------------------------------------------------------------

# Port the Next.js app listens on. Default 3000. Set when running on a
# non-default port (e.g. 3201 behind nginx).
PORT=3000

# Secret shared with the FastAPI backend. When the backend sends
# x-internal-api-secret with this value, the middleware skips auth and
# forwards the request. Optional; omit if you do not use internal proxy auth.
INTERNAL_API_SECRET=

# -----------------------------------------------------------------------------
# UI and feature flags (NEXT_PUBLIC_* = visible in browser)
# -----------------------------------------------------------------------------

# Application lifecycle badge: pre-alpha | alpha | beta. When set, a status
# banner is shown. In development, "alpha" is shown if unset.
NEXT_PUBLIC_APPLICATION_STATUS=

# Feedback link in the UI. URL for "Give feedback" (mailto: or https://).
# Optional label via NEXT_PUBLIC_FEEDBACK_CONTACT_LABEL (default: "Contact us for feedback").
NEXT_PUBLIC_FEEDBACK_CONTACT_URL=
NEXT_PUBLIC_FEEDBACK_CONTACT_LABEL=

# After closing the artifact panel without a trigger message: "bottom" = scroll
# chat to latest; "trigger" = leave scroll position as-is. Default: bottom
NEXT_PUBLIC_ARTIFACT_SCROLL_BEHAVIOR=

# When "true" or "1", show part type (e.g. text, tool-xyz) in the Reasoning block.
NEXT_PUBLIC_SHOW_REASONING_PART_TYPE=

# Base URL for WDR2026 figure/static assets (no trailing slash). When set,
# figure_image_path from wdr2026 search is resolved as base + path.
# Example: https://wdr2026.example.com. Unset = paths used as-is (same-origin).
NEXT_PUBLIC_WDR2026_ASSETS_BASE=

# Full URL for the WDR2026 source PDF. When set, text search results show
# "View page in PDF" and the artifact panel opens the PDF at the segment's page.
# Optional. If unset, derived from NEXT_PUBLIC_WDR2026_ASSETS_BASE + /documents/
# when that is set (requires wdr2026-mcp to serve data/WDR2026/documents/).
NEXT_PUBLIC_WDR2026_PDF_URL=

# -----------------------------------------------------------------------------
# Development / build
# -----------------------------------------------------------------------------

# Comma-separated origins allowed for cross-origin requests to _next/* in
# development (e.g. when the dev server is iframed or accessed from another
# host). Example: https://w1lxscirender02.worldbank.org
NEXT_PUBLIC_ALLOWED_DEV_ORIGINS=

# Optional. Path to streamdown dist for postcss-source-resolve (build-time).
# STREAMDOWN_DIST_PATH=
