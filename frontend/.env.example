# Database (for migrations and remaining queries)
# Note: Use postgresql:// format (not postgresql+asyncpg://)
# POSTGRES_URL=postgresql+asyncpg://<user>:<password>@localhost:<port>/<neondb>
POSTGRES_URL=postgresql://user:password@localhost:5432/chatbot_db   # pragma: allowlist secret

# Frontend API Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# URL to the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8001

# Internal API Secret (for FastAPI → Next.js requests)
INTERNAL_API_SECRET=dev-internal-secret-change-in-production

# Optional: custom Vega/Vega-Lite theme JSON URL (used by chart artifacts)
NEXT_PUBLIC_VEGA_CUSTOM_THEME_URL=https://worldbank.github.io/data-visualization-style-guide/vega/wb-vega-theme.json


# # One of pre-alpha, alpha, beta
NEXT_PUBLIC_APPLICATION_STATUS=alpha
# # This is the link that the user will be redirected to in the feedback form.
# NEXT_PUBLIC_FEEDBACK_CONTACT_URL=https://example.com/feedback
# # This is the message shown in the UI.
# NEXT_PUBLIC_FEEDBACK_CONTACT_LABEL=Share your feedback

# Shows the part type in the thinking component stepper if true
NEXT_PUBLIC_SHOW_REASONING_PART_TYPE=false
