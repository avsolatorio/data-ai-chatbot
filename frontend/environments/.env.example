# =============================================================================
# Environment Variables
# =============================================================================
# Copy to .env.local and customize. See docs/env-variables.md for full reference.
# For Azure deployment, see docs/azure-env-setup.md.
# =============================================================================

# --- Environment identifier ---
# Required: Set per deployment (dev|qa|uat|prod). Used for URL presets.
NEXT_PUBLIC_APP_ENV=dev

# --- Database (deprecated: frontend no longer connects to DB; backend owns DB) ---
# POSTGRES_URL is no longer required. The FastAPI backend handles all database operations.
# POSTGRES_URL=postgresql://user:password@localhost:5432/chatbot_db   # pragma: allowlist secret

# --- Frontend API Configuration ---
NEXT_PUBLIC_BASE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: subpath for deployment (e.g. "/app" when app is at https://example.com/app/).
# When set, must match basePath in next.config. Do not use trailing slash. Leave unset for root.
# NEXT_PUBLIC_BASE_PATH=/app

# URL to the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8001

# Server-side API URL; preferred for server routes. When unset, falls back to NEXT_PUBLIC_API_URL.
# SERVER_API_URL=http://localhost:8001

# Optional: timeout (ms) for auth proxy requests to FastAPI (/api/auth/me, /api/auth/refresh). Default 15000.
# AUTH_PROXY_TIMEOUT_MS=15000

# Internal API Secret (for FastAPI → Next.js requests)
INTERNAL_API_SECRET=dev-internal-secret-change-in-production

# Optional: custom Vega/Vega-Lite theme JSON URL (used by chart artifacts)
NEXT_PUBLIC_VEGA_CUSTOM_THEME_URL=https://worldbank.github.io/data-visualization-style-guide/vega/wb-vega-theme.json

# Base URL for Data360 indicator links in the chat Sources list (from tool-data360_get_data). Default matches production Data360.
# NEXT_PUBLIC_DATA360_INDICATOR_BASE_URL=https://data360.worldbank.org/en/indicator

# When true, all Data360 MCP tool panels start expanded. When false (recommended), only chart + get_data expand by default; search/metadata/codelist/etc. stay collapsed to save vertical space.
# NEXT_PUBLIC_DATA360_TOOL_DEFAULT_OPEN=true

# Optional (data360 auth only): periodic POST (credentials: include) to refresh searchToken (e.g. AEM). Empty = disabled.
# Runs only when NEXT_PUBLIC_AUTH_PROVIDER=data360. Interval defaults to 50 minutes (3000000 ms) when URL is set.
# NEXT_PUBLIC_SEARCH_TOKEN_REFRESH_URL=/wbg/aem/service/refresh-search-token
# NEXT_PUBLIC_SEARCH_TOKEN_REFRESH_INTERVAL_MS=3000000

# File upload (multimodal images). Default off; set true to enable paperclip and paste. Keep size/types in sync with backend if you override.
# NEXT_PUBLIC_ENABLE_IMAGE_UPLOAD=true
# NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=5242880
# NEXT_PUBLIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png

# Public chat / share-via-link (sidebar Share + header visibility). Default off. Set true with backend ENABLE_SHARE_CONVERSATION.
# NEXT_PUBLIC_ENABLE_SHARE_CONVERSATION=true

# # One of pre-alpha, alpha, beta
NEXT_PUBLIC_APPLICATION_STATUS=alpha
# # This is the link that the user will be redirected to in the feedback form.
# NEXT_PUBLIC_FEEDBACK_CONTACT_URL=https://example.com/feedback
# # This is the message shown in the UI.
# NEXT_PUBLIC_FEEDBACK_CONTACT_LABEL=Share your feedback

# Shows the part type in the thinking component stepper if true
NEXT_PUBLIC_SHOW_REASONING_PART_TYPE=false

# Artifact scroll behavior: bottom (scroll to bottom) or trigger (scroll on trigger).
# NEXT_PUBLIC_ARTIFACT_SCROLL_BEHAVIOR=bottom

# Enable World Bank data header when true.
# NEXT_PUBLIC_DATA_HEADER_ENABLED=false

# Data header CSS and script URLs. When unset, defaults to extdataportalqa.worldbank.org QA assets.
# NEXT_PUBLIC_DATA_HEADER_CSS_URL=https://extdataportalqa.worldbank.org/qa/api/ext/header/webasset/data/dataheaderservice/clientlibs/site.css
# NEXT_PUBLIC_DATA_HEADER_SCRIPT_URL=https://extdataportalqa.worldbank.org/qa/api/ext/header/webasset/data/dataheaderservice/clientlibs/site.js

# populateDataHeader tier: dev | qa | prod (default qa).
# NEXT_PUBLIC_DATA_HEADER_ENVIRONMENT=qa

# Landing page "Did you know...?" insights section. Default off; set true or 1 to enable.
# NEXT_PUBLIC_LANDING_INSIGHTS_ENABLED=false

# If set to `true` or `1` activates the maintenance page.
MAINTENANCE_MODE=false
# When true, redirect to /maintenance if GET {SERVER_API_URL}/ready is not OK (cached; fail-open if API URL unset).
# MAINTENANCE_ON_BACKEND_UNREADY=false
# BACKEND_READY_CACHE_MS=20000
# BACKEND_READY_FETCH_TIMEOUT_MS=3000

# CSP (Content-Security-Policy). Disabled by default. Set to true or 1 to enable.
# CSP_ENABLED=true

# CSP violation reporting. When enabled (default), browsers POST violations to /api/csp-report.
# Set to false or 0 to disable. Only applies when CSP_ENABLED is true.
# CSP_REPORT_ENABLED=true

# Auth: guest (login = Try as guest only) | user (email/password + Try as guest) | msal | data360
# NEXT_PUBLIC_AUTH_PROVIDER=guest
# NEXT_PUBLIC_AUTH_PROVIDER=user
# NEXT_PUBLIC_AUTH_PROVIDER=msal
# NEXT_PUBLIC_AUTH_PROVIDER=data360

# Skip login page in guest/MSAL modes. When true (default), redirect or trigger sign-in directly.
# Set to false to show the login page ("Try as guest" / "Login with MSAL").
# NEXT_PUBLIC_SKIP_LOGIN_PAGE=true
# NEXT_PUBLIC_MSAL_CLIENT_ID=<client-id>
# NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:3001
# # When unset, defaults to origin + NEXT_PUBLIC_BASE_PATH + /login. Must match Azure AD app registration.

# # Optional: single-tenant and API scope
# NEXT_PUBLIC_MSAL_AUTHORITY=https://login.microsoftonline.com/<tenant-id/org>

# When chat app is embedded in a parent app: parent sets searchToken cookie (MSAL JWT) before redirect.
# Chat app checks searchToken first; if valid, skips MSAL flow. No env var needed.

# Data360 mode: required when NEXT_PUBLIC_AUTH_PROVIDER=data360.
# URL to redirect when unauthenticated or token expired (401). Parent app re-auths and sets searchToken.
# NEXT_PUBLIC_DATA360_AUTH_URL=https://example.com/auth
