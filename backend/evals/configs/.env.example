# Eval Framework Environment Variables
# Copy to .env and fill in values before running evals.
#
# Usage:
#   cp backend/evals/.env.example backend/evals/.env
#   # Edit values, then:
#   PYTHONPATH=. uv run python -m evals.run_conversation_eval --http --persona all

# ── Chatbot Endpoints ────────────────────────────────────────────
# Local:       http://localhost:3001 / http://localhost:8001
# Production:  https://your-chatbot.example.org (behind VPN)

CHATBOT_URL=http://localhost:3001
CHATBOT_API_BASE=http://localhost:8001

# ── MCP Server ───────────────────────────────────────────────────
# The eval runner does NOT need MCP_SERVER_URL. It validates MCP
# connectivity by calling the backend's tool-listing endpoint
# (GET /api/v1/mcp/tools). The backend's own .env must have
# MCP_SERVER_URL configured for the chatbot to work.

# MCP_SERVER_URL=  (not used by the eval runner)

# ── LLM API Keys ─────────────────────────────────────────────────
# Required for the judge model (default: gpt-4.1-mini).

OPENAI_API_KEY=

# ── Judge Model Override ─────────────────────────────────────────
# Override the judge model from eval_config.yaml.

# DEEPEVAL_JUDGE_MODEL=gpt-4.1-mini

# ── DeepEval Cloud (Optional) ───────────────────────────────────
# For uploading results to the DeepEval dashboard.

# DEEPEVAL_API_KEY=

# ── SSL / Corporate Certificates ────────────────────────────────
# If behind a corporate proxy with a custom root CA.
# The cert is already in the repo at backend/certs/corp-root-ca.crt.

# SSL_CERT_FILE=./backend/certs/corp-root-ca.crt
# REQUESTS_CA_BUNDLE=./backend/certs/corp-root-ca.crt
